<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DocuMind</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        function applyTimeTheme() {
            var hour = new Date().getHours();
            var theme;
            if (hour >= 6 && hour < 12)      theme = "morning";
            else if (hour >= 12 && hour < 18) theme = "afternoon";
            else if (hour >= 18 && hour < 22) theme = "evening";
            else                              theme = "night";
            document.documentElement.setAttribute("data-theme", theme);
            console.log("DocuMind theme:", theme, "hour:", hour);
        }
        applyTimeTheme();
        setInterval(applyTimeTheme, 60000);
    </script>
</body>
</html>
