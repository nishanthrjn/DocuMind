@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>DocuMind</PageTitle>

<div class="dm-layout">

    <!-- Left Panel — Sources + Conversations -->
    <div class="dm-sidebar">
        <div class="dm-sidebar-header">
            <div class="dm-sidebar-title">📚 Sources</div>
            <button class="dm-add-btn" @onclick='() => _showUpload = !_showUpload'>
                @(_showUpload ? "✕" : "+ Add")
            </button>
        </div>

        @if (_showUpload)
        {
            <div class="dm-upload-panel">
                <div class="dm-upload-drop">
                    <InputFile OnChange="OnFilesSelected" accept=".pdf,.txt"
                               class="dm-file-input" multiple />
                    <div class="dm-upload-hint">
                        <span>📁</span>
                        <span>PDF or TXT</span>
                    </div>
                </div>
                @if (_selectedFiles.Any())
                {
                    @foreach (var f in _selectedFiles)
                    {
                        <div class="dm-upload-file">📄 @TruncateFilename(f.Name, 25)</div>
                    }
                    <button class="dm-upload-btn" @onclick="UploadDocuments" disabled="@_uploading">
                        @if (_uploading) { <span class="spinner-sm"></span> <span>Ingesting...</span> }
                        else { <span>⚡ Ingest @_selectedFiles.Count file(s)</span> }
                    </button>
                }
                @if (!string.IsNullOrEmpty(_uploadMessage))
                {
                    <div class="dm-upload-msg @(_uploadSuccess ? "ok" : "err")">@_uploadMessage</div>
                }
            </div>
        }

        <div class="dm-source-list">
            @if (_documents.Any())
            {
                @foreach (var doc in _documents)
                {
                    <div class="dm-source-item @(_selectedDoc?.Id == doc.Id ? "selected" : "")"
                         @onclick="() => SelectDocument(doc)">
                        <div class="dm-source-icon">@(doc.Status == "Failed" ? "❌" : "📄")</div>
                        <div class="dm-source-info">
                            <div class="dm-source-name" title="@doc.FileName">
                                @TruncateFilename(doc.FileName, 22)
                            </div>
                            <div class="dm-source-meta">
                                <span class="dm-status-dot dm-status-@doc.Status.ToLower()"></span>
                                @doc.ChunkCount chunks
                            </div>
                        </div>
                        <button class="dm-source-del"
                                @onclick:stopPropagation="true"
                                @onclick="() => DeleteDocument(doc.Id)">×</button>
                    </div>
                }
                <button class="dm-delete-all-btn" @onclick="DeleteAllDocuments">🗑️ Delete all sources</button>
            }
            else
            {
                <div class="dm-source-empty">No sources yet.<br/>Click + Add to upload.</div>
            }
        </div>

        <!-- Saved Conversations -->
        <div class="dm-conv-section">
            <div class="dm-conv-header">
                <span>💬 Chats</span>
                @if (_conversation.Any())
                {
                    <button class="dm-save-btn" @onclick="SaveConversation">💾 Save</button>
                }
            </div>
            <div class="dm-conv-list">
                @if (_savedConversations.Any())
                {
                    @foreach (var conv in _savedConversations)
                    {
                        <div class="dm-conv-item @(_currentConvId == conv.Id ? "active" : "")"
                             @onclick="() => LoadConversation(conv.Id)">
                            <div class="dm-conv-title">@conv.Title</div>
                            <div class="dm-conv-meta">@conv.UpdatedAt.ToString("dd MMM HH:mm")</div>
                            <button class="dm-source-del"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => DeleteConversation(conv.Id)">×</button>
                        </div>
                    }
                }
                else
                {
                    <div class="dm-conv-empty">No saved chats yet.</div>
                }
            </div>
        </div>
    </div>

    <!-- Right Panel — Chat -->
    <div class="dm-main">
        <div class="dm-chat-header">
            <div class="dm-chat-title">
                @if (!string.IsNullOrEmpty(_currentConvTitle))
                {
                    <span>💬 @_currentConvTitle</span>
                }
                else
                {
                    <span>💬 Chat</span>
                }
            </div>
            <div style="display:flex;gap:8px;">
                @if (_conversation.Any())
                {
                    <button class="dm-save-btn" @onclick="SaveConversation">💾 Save</button>
                    <button class="dm-clear-btn" @onclick="NewConversation">+ New</button>
                    <button class="dm-clear-btn" @onclick="ClearConversation">Clear</button>
                }
            </div>
        </div>

        <div class="dm-chat-body">
            @if (_conversation.Any())
            {
                @foreach (var msg in _conversation)
                {
                    <div class="dm-msg dm-msg-@msg.Role">
                        <div class="dm-msg-label">@(msg.Role == "user" ? "You" : "DocuMind")</div>
                        <div class="dm-msg-body">@((MarkupString)RenderMarkdown(msg.Content))</div>
                        @if (msg.Role == "assistant")
                        {
                            <div class="dm-msg-footer">
                                @if (msg.Citations.Any())
                                {
                                    <div class="dm-msg-citations">
                                        @foreach (var c in msg.Citations)
                                        {
                                            <div class="dm-citation-pill @(_activeCitation == c ? "active" : "")"
                                                    title="@c.FileName"
                                                    @onclick="() => _activeCitation = _activeCitation == c ? null : c">
                                                    📄 @TruncateFilename(c.FileName, 30)
                                                </div>
                                        }
                                    </div>
                                }
                                <button class="dm-copy-btn" @onclick="() => CopyToClipboard(msg.Content)">
                                    📋 Copy
                                </button>
                            </div>
                            @if (_conversation.Last() == msg && !_querying)
                            {
                                <div class="dm-followup">
                                    @foreach (var q in GetFollowUpQuestions(msg.Content))
                                    {
                                        <button class="dm-followup-btn" @onclick="() => AskSuggestion(q)">@q</button>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
                @if (_querying)
                {
                    <div class="dm-msg dm-msg-assistant">
                        <div class="dm-msg-label">DocuMind</div>
                        <div class="dm-typing"><span></span><span></span><span></span></div>
                    </div>
                }
            }
            else
            {
                <div class="dm-empty-chat">
                    <div class="dm-empty-icon">💬</div>
                    <div class="dm-empty-title">Ask about your documents</div>
                    <div class="dm-empty-subtitle">
                        @_documents.Count(d => d.Status == "Processed") document(s) ready
                    </div>
                    @if (_documents.Any(d => d.Status == "Processed"))
                    {
                        <div class="dm-suggestions">
                            @foreach (var q in GetSuggestedQuestions())
                            {
                                <button class="dm-suggestion-btn" @onclick="() => AskSuggestion(q)">@q</button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="dm-input-area">
            <div class="dm-input-row">
                <textarea @bind="_question" @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="Ask a question about your documents..."
                          rows="2" disabled="@_querying"></textarea>
                <button class="dm-send-btn" @onclick="SendMessage"
                        disabled="@(_querying || string.IsNullOrWhiteSpace(_question))">
                    @if (_querying) { <span class="spinner"></span> }
                    else { <span>➤</span> }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string _question         = "";
    private bool   _querying         = false;
    private bool   _uploading        = false;
    private bool   _showUpload       = false;
    private string _uploadMessage    = "";
    private bool   _uploadSuccess    = false;
    private string _currentConvTitle = "";
    private Guid?  _currentConvId    = null;

    private List<IBrowserFile>        _selectedFiles       = new();
    private List<DocumentSummary>     _documents           = new();
    private List<ConversationTurn>    _conversation        = new();
    private List<ConvSummary>         _savedConversations  = new();
    private DocumentSummary?          _selectedDoc         = null;
    private CitationDisplay?          _activeCitation      = null;

    private HttpClient _http = new()
    {
        BaseAddress = new Uri("http://localhost:5082"),
        Timeout     = TimeSpan.FromMinutes(10)
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDocuments();
            await LoadConversationList();
        }
    }

    private void SelectDocument(DocumentSummary doc)
    {
        _selectedDoc = _selectedDoc?.Id == doc.Id ? null : doc;
        StateHasChanged();
    }

    private List<string> GetSuggestedQuestions() => new()
    {
        "What are the main contributions of these papers?",
        "Summarize the key findings across all documents",
        "What methods or techniques are described?"
    };

    private List<string> GetFollowUpQuestions(string lastAnswer)
    {
        // Generate contextual follow-ups based on conversation
        var followUps = new List<string>
        {
            "Can you explain this in simpler terms?",
            "What are the limitations of these approaches?",
            "How do these compare to each other?",
            "What are the practical applications?",
            "Can you give a concrete example?"
        };
        // Rotate based on conversation length to vary suggestions
        var offset = _conversation.Count % followUps.Count;
        return followUps.Skip(offset).Concat(followUps.Take(offset)).Take(3).ToList();
    }

    private async Task AskSuggestion(string question)
    {
        _question = question;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_querying)
            await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_question) || _querying) return;

        var userQuestion = _question.Trim();
        _question = "";
        _querying = true;
        _conversation.Add(new ConversationTurn("user", userQuestion, new()));
        StateHasChanged();

        try
        {
            var history = _conversation
                .Take(_conversation.Count - 1)
                .TakeLast(2)
                .Select(t => new HistoryMessage(t.Role, t.Content))
                .ToList();

            var payload  = System.Text.Json.JsonSerializer.Serialize(
                new { question = userQuestion, topK = 5, history });
            var content  = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
            var response = await _http.PostAsync("/api/query", content);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc  = System.Text.Json.JsonDocument.Parse(json);
                var answer = doc.RootElement.TryGetProperty("answer", out var a) ? a.GetString() ?? "" : "";

                var citations     = new List<CitationDisplay>();
                var seenCitations = new HashSet<string>();
                if (doc.RootElement.TryGetProperty("citations", out var cits))
                {
                    foreach (var c in cits.EnumerateArray())
                    {
                        var fn  = c.TryGetProperty("fileName",     out var f) ? f.GetString() ?? "" : "";
                        var cp  = c.TryGetProperty("chunkPreview", out var p) ? p.GetString() ?? "" : "";
                        var key = fn + cp[..Math.Min(50, cp.Length)];
                        if (seenCitations.Add(key))
                            citations.Add(new CitationDisplay(fn, cp));
                    }
                }
                _conversation.Add(new ConversationTurn("assistant", answer, citations));
            }
            else
            {
                _conversation.Add(new ConversationTurn("assistant",
                    $"Query failed: {response.StatusCode}", new()));
            }
        }
        catch (Exception ex)
        {
            _conversation.Add(new ConversationTurn("assistant", $"Error: {ex.Message}", new()));
        }

        _querying = false;
        StateHasChanged();
    }

    private async Task SaveConversation()
    {
        if (!_conversation.Any()) return;

        var title = _currentConvTitle;
        if (string.IsNullOrEmpty(title))
        {
            var firstMsg = _conversation.FirstOrDefault(m => m.Role == "user");
            title = firstMsg?.Content.Length > 40
                ? firstMsg.Content[..40] + "..."
                : firstMsg?.Content ?? "Conversation";
            _currentConvTitle = title;
        }

        var id = _currentConvId ?? Guid.NewGuid();
        _currentConvId = id;

        var messages = _conversation.Select(m => new
        {
            role     = m.Role,
            content  = m.Content,
            citations = System.Text.Json.JsonSerializer.Serialize(m.Citations)
        }).ToList();

        var payload  = System.Text.Json.JsonSerializer.Serialize(new { id, title, messages });
        var content  = new StringContent(payload, System.Text.Encoding.UTF8, "application/json");
        await _http.PostAsync("/api/conversations", content);
        await LoadConversationList();
        StateHasChanged();
    }

    private async Task LoadConversationList()
    {
        try
        {
            var response = await _http.GetAsync("/api/conversations");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc  = System.Text.Json.JsonDocument.Parse(json);
                _savedConversations = new();
                foreach (var c in doc.RootElement.EnumerateArray())
                {
                    _savedConversations.Add(new ConvSummary(
                        c.TryGetProperty("id",        out var id) ? Guid.Parse(id.GetString()!) : Guid.Empty,
                        c.TryGetProperty("title",     out var t)  ? t.GetString() ?? "" : "",
                        c.TryGetProperty("updatedAt", out var u)
                            ? DateTime.TryParse(u.GetString(), out var dt) ? dt : DateTime.Now : DateTime.Now,
                        c.TryGetProperty("messageCount", out var mc) ? mc.GetInt32() : 0));
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task LoadConversation(Guid id)
    {
        try
        {
            var response = await _http.GetAsync($"/api/conversations/{id}");
            if (!response.IsSuccessStatusCode) return;

            var json = await response.Content.ReadAsStringAsync();
            var doc  = System.Text.Json.JsonDocument.Parse(json);

            _currentConvId    = id;
            _currentConvTitle = doc.RootElement.TryGetProperty("title", out var t)
                ? t.GetString() ?? "" : "";

            _conversation = new();
            if (doc.RootElement.TryGetProperty("messages", out var msgs))
            {
                foreach (var m in msgs.EnumerateArray())
                {
                    var role    = m.TryGetProperty("role",    out var r) ? r.GetString() ?? "" : "";
                    var content = m.TryGetProperty("content", out var c) ? c.GetString() ?? "" : "";
                    var citJson = m.TryGetProperty("citations", out var ci) ? ci.GetString() ?? "[]" : "[]";

                    var citations = new List<CitationDisplay>();
                    try
                    {
                        var citDoc = System.Text.Json.JsonDocument.Parse(citJson);
                        foreach (var cit in citDoc.RootElement.EnumerateArray())
                        {
                            citations.Add(new CitationDisplay(
                                cit.TryGetProperty("FileName", out var fn) ? fn.GetString() ?? "" : "",
                                cit.TryGetProperty("Preview",  out var p)  ? p.GetString()  ?? "" : ""));
                        }
                    }
                    catch { }

                    _conversation.Add(new ConversationTurn(role, content, citations));
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task DeleteConversation(Guid id)
    {
        await _http.DeleteAsync($"/api/conversations/{id}");
        if (_currentConvId == id) NewConversation();
        await LoadConversationList();
    }

    private void NewConversation()
    {
        _conversation     = new();
        _currentConvId    = null;
        _currentConvTitle = "";
        StateHasChanged();
    }

    private void ClearConversation()
    {
        _conversation = new();
        StateHasChanged();
    }

    private async Task CopyToClipboard(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _selectedFiles = e.GetMultipleFiles(10).ToList();
        _uploadMessage = "";
        StateHasChanged();
    }

    private async Task UploadDocuments()
    {
        if (!_selectedFiles.Any()) return;
        _uploading = true; _uploadMessage = "";
        StateHasChanged();

        int success = 0, failed = 0;
        foreach (var file in _selectedFiles)
        {
            try
            {
                using var content = new MultipartFormDataContent();
                using var stream  = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
                using var sc      = new StreamContent(stream);
                var ext = System.IO.Path.GetExtension(file.Name).ToLower();
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    ext == ".pdf" ? "application/pdf" : "text/plain");
                content.Add(sc, "file", file.Name);
                var r = await _http.PostAsync("/api/documents/ingest", content);
                if (r.IsSuccessStatusCode) success++; else failed++;
            }
            catch { failed++; }
        }

        _uploadSuccess = failed == 0;
        _uploadMessage = failed == 0
            ? $"✅ {success} file(s) ingested!"
            : $"⚠️ {success} ok, {failed} failed.";

        _selectedFiles = new();
        await LoadDocuments();
        if (success > 0) _showUpload = false;
        _uploading = false;
        StateHasChanged();
    }

    private async Task LoadDocuments()
    {
        try
        {
            var response = await _http.GetAsync("/api/documents");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var doc  = System.Text.Json.JsonDocument.Parse(json);
                _documents = new();
                foreach (var d in doc.RootElement.EnumerateArray())
                {
                    _documents.Add(new DocumentSummary(
                        d.TryGetProperty("id",         out var id) ? id.GetString() ?? "" : "",
                        d.TryGetProperty("fileName",   out var fn) ? fn.GetString() ?? "" : "",
                        d.TryGetProperty("chunkCount", out var cc) ? cc.GetInt32() : 0,
                        d.TryGetProperty("createdAt",  out var ca)
                            ? DateTime.TryParse(ca.GetString(), out var dt) ? dt : DateTime.Now
                            : DateTime.Now,
                        d.TryGetProperty("status",     out var st) ? st.GetString() ?? "" : ""));
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    private async Task DeleteDocument(string id)
    {
        if (_selectedDoc?.Id == id) _selectedDoc = null;
        try { var r = await _http.DeleteAsync($"/api/documents/{id}"); if (r.IsSuccessStatusCode) await LoadDocuments(); }
        catch { }
    }

    private async Task DeleteAllDocuments()
    {
        _selectedDoc = null; _conversation = new();
        try { var r = await _http.DeleteAsync("/api/documents"); if (r.IsSuccessStatusCode) { _documents = new(); await InvokeAsync(StateHasChanged); } }
        catch { }
    }

    private string RenderMarkdown(string md)
    {
        try { return Markdig.Markdown.ToHtml(md); }
        catch { return md; }
    }

    private string TruncateFilename(string name, int max) =>
        name.Length > max ? name[..max] + "..." : name;

    public ValueTask DisposeAsync() { _http.Dispose(); return ValueTask.CompletedTask; }

    record ConversationTurn(string Role, string Content, List<CitationDisplay> Citations);
    record CitationDisplay(string FileName, string Preview);
    record CitationPopup(string FileName, string Content);
    record DocumentSummary(string Id, string FileName, int ChunkCount, DateTime CreatedAt, string Status);
    record ConvSummary(Guid Id, string Title, DateTime UpdatedAt, int MessageCount);
    record HistoryMessage(string Role, string Content);
}









